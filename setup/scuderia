#!/usr/bin/env python3
"""scuderia — the platform CLI (skeleton).

Commands over one declarative core (the profile's manifest.yaml):

  scuderia init   --profile mnemo --name <name> --path <dir>
      Scaffold a new instance: create the manifest's dirs, copy its templated
      files with {{INSTANCE_NAME}} / {{CREATED}} substituted.

  scuderia doctor --path <dir>
      Verify the instance contract (spec §5) against the bound profile:
      instance.yaml parses with the required keys; every page directory
      declared
      by the profile's schema.yaml exists; skills/ exists; version pins are
      satisfiable. Exits nonzero with one complaint per failure. Idempotent;
      the shared definition of done.

  scuderia skill-check [--root <checkout>] [--strict]
      Platform-level skill hygiene: fails on frontmatter `name:` collisions
      across skills roots (shared skills/ + profiles/*/skills/), warns on
      patch-marker skills ("patch pending", "should be folded into", ...).
      A name collision is how resolver deadlocks and patch-skill sprawl
      start; run in CI or before committing skill changes.

  scuderia adopt  --path <existing vault> [--name <name>] [--profile mnemo]
      Generate instance.yaml for a pre-existing instance and validate it.
      Refuses to overwrite an existing instance.yaml (or legacy brain.yaml).

Dependencies: stdlib + PyYAML (also required by core/tools/lint-frontmatter.py).
Run in place from the scuderia checkout: `setup/scuderia <cmd>`.
"""

from __future__ import annotations

import argparse
import datetime
import sys
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit("scuderia requires PyYAML (pip install pyyaml) — also used by "
             "core/tools/lint-frontmatter.py")

SOMA_ROOT = Path(__file__).resolve().parent.parent
INSTANCE_YAML_KEYS = ("name", "profile", "profile_version", "schema_version", "created")


def profile_dir(profile: str) -> Path:
    d = SOMA_ROOT / "profiles" / profile
    if not d.is_dir():
        sys.exit(f"scuderia: unknown profile `{profile}` (no profiles/{profile}/ "
                 f"in this checkout)")
    return d


def load_yaml(path: Path) -> dict:
    try:
        doc = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as e:
        sys.exit(f"scuderia: could not parse {path}: {e}")
    return doc if isinstance(doc, dict) else {}


def substitute(text: str, name: str, created: str, strip_header: bool = False) -> str:
    if strip_header:
        # Template files open with a "> ..." preamble addressed to template
        # readers, terminated by a "> ---" marker line. Instances get only
        # the body below it.
        lines = text.splitlines(keepends=True)
        for i, line in enumerate(lines):
            if line.strip() == "> ---":
                text = "".join(lines[i + 1:]).lstrip("\n")
                break
    return (text
            .replace("{{INSTANCE_NAME}}", name)
            .replace("{{CREATED}}", created))


def cmd_init(args: argparse.Namespace) -> int:
    prof = profile_dir(args.profile)
    manifest = load_yaml(prof / "manifest.yaml")
    target = args.path.expanduser().resolve()
    created = datetime.date.today().isoformat()

    if target.exists() and any(target.iterdir()) and not args.force:
        sys.exit(f"scuderia init: {target} is not empty (pass --force to scaffold "
                 f"into it anyway)")
    target.mkdir(parents=True, exist_ok=True)

    for d in manifest.get("dirs", []):
        (target / d).mkdir(parents=True, exist_ok=True)
        (target / d / ".gitkeep").touch(exist_ok=True)

    for entry in manifest.get("files", []):
        src = prof / entry["template"]
        dst = target / entry["target"]
        if dst.exists() and not args.force:
            print(f"  skip (exists): {entry['target']}")
            continue
        if not src.is_file():
            sys.exit(f"scuderia init: manifest template missing: {src}")
        # File targets create their own parent dirs — a manifest file must
        # never depend on a `dirs` entry landing first (cf. the mnemo USER/
        # red-CI bug, 6925e64).
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(substitute(src.read_text(encoding="utf-8"),
                                  args.name, created,
                                  strip_header=bool(entry.get("strip_header"))),
                       encoding="utf-8")
        print(f"  wrote: {entry['target']}")

    print(f"scuderia init: scaffolded `{args.name}` (profile {args.profile}) at "
          f"{target}")
    print("next: bind your harness per docs/harnesses/<harness>.md, then "
          f"`scuderia doctor --path {target}`")
    return 0


def check_contract(path: Path, prof_name: str | None) -> list[str]:
    """Return a list of contract violations; empty means valid."""
    complaints: list[str] = []

    contract_file = path / "instance.yaml"
    legacy_file = path / "brain.yaml"
    if not contract_file.is_file() and legacy_file.is_file():
        contract_file = legacy_file
        print("  note: brain.yaml is deprecated — rename it to instance.yaml")
    if not contract_file.is_file():
        return [f"instance.yaml missing at {path} — run `scuderia adopt --path {path}` "
                f"or `scuderia init`"]

    data = load_yaml(contract_file)
    for key in INSTANCE_YAML_KEYS:
        if key not in data:
            complaints.append(f"{contract_file.name}: missing required key `{key}`")

    profile = data.get("profile", prof_name or "mnemo")
    prof = SOMA_ROOT / "profiles" / str(profile)
    if not prof.is_dir():
        complaints.append(f"{contract_file.name}: profile `{profile}` not present in "
                          f"this scuderia checkout")
        return complaints

    schema_path = prof / "schema.yaml"
    if not schema_path.is_file():
        complaints.append(f"profile `{profile}` has no schema.yaml")
        return complaints
    schema = load_yaml(schema_path)

    for spec in schema.get("kinds", {}).values():
        d = path / spec["dir"]
        if not d.is_dir():
            complaints.append(f"page directory missing: {spec['dir']}/")

    if not (path / "skills").is_dir():
        complaints.append("skills/ directory missing (may be empty, must exist)")

    # Version pins: the brain's schema_version must be satisfiable by the
    # profile schema it binds to (currently: must not exceed it).
    brain_sv = data.get("schema_version")
    prof_sv = schema.get("schema_version")
    if isinstance(brain_sv, int) and isinstance(prof_sv, int):
        if brain_sv > prof_sv:
            complaints.append(
                f"{contract_file.name} pins schema_version {brain_sv} but profile "
                f"`{profile}` ships {prof_sv} — update the scuderia checkout")

    # Binding health: harness-side bindings are adapter-doc one-liners the CLI
    # does not perform (spec §8). Surface them as a reminder, not a failure.
    manifest = load_yaml(prof / "manifest.yaml")
    for b in manifest.get("bindings", []):
        print(f"  binding to verify ({b['id']}): {b['description']}")
    return complaints


def cmd_doctor(args: argparse.Namespace) -> int:
    path = args.path.expanduser().resolve()
    complaints = check_contract(path, args.profile)
    if complaints:
        print("scuderia doctor: FAIL")
        for c in complaints:
            print(f"  - {c}")
        return 1
    print(f"scuderia doctor: OK — {path} is a valid instance")
    return 0


PATCH_MARKERS = (
    "patch pending",
    "should absorb this patch",
    "should absorb these patches",
    "should be folded into",
    "fold into the vault-side",
)


def skill_roots(root: Path) -> list[tuple[str, Path]]:
    """Every skills root in a scuderia checkout: the shared set (if it ever
    exists) plus each profile's scoped set."""
    roots: list[tuple[str, Path]] = []
    shared = root / "skills"
    if shared.is_dir():
        roots.append(("shared", shared))
    profiles = root / "profiles"
    if profiles.is_dir():
        for p in sorted(profiles.iterdir()):
            sk = p / "skills"
            if sk.is_dir():
                roots.append((f"profile:{p.name}", sk))
    return roots


def skill_name(skill_md: Path) -> str | None:
    """Frontmatter `name:` of a SKILL.md, or None if unreadable."""
    try:
        text = skill_md.read_text(encoding="utf-8")
    except OSError:
        return None
    if not text.startswith("---"):
        return None
    parts = text.split("---", 2)
    if len(parts) < 3:
        return None
    try:
        fm = yaml.safe_load(parts[1])
    except yaml.YAMLError:
        return None
    return fm.get("name") if isinstance(fm, dict) else None


def cmd_skill_check(args: argparse.Namespace) -> int:
    root = (args.root.expanduser().resolve() if args.root else SOMA_ROOT)
    roots = skill_roots(root)
    if not roots:
        print(f"scuderia skill-check: no skills roots found under {root}")
        return 0

    seen: dict[str, list[str]] = {}
    warnings: list[str] = []
    count = 0
    for label, sroot in roots:
        for skill_md in sorted(sroot.rglob("SKILL.md")):
            count += 1
            name = skill_name(skill_md)
            rel = skill_md.relative_to(root)
            if name is None:
                warnings.append(f"{rel}: no frontmatter `name:` (unreadable)")
                continue
            seen.setdefault(name, []).append(f"{rel} [{label}]")
            try:
                body = skill_md.read_text(encoding="utf-8").lower()
            except OSError:
                continue
            for marker in PATCH_MARKERS:
                if marker in body:
                    warnings.append(
                        f"{rel}: patch-marker '{marker}' — patch skills are "
                        f"not a pattern; fold into the target skill")
                    break

    duplicates = {n: locs for n, locs in seen.items() if len(locs) > 1}
    for w in warnings:
        print(f"  warning: {w}")
    if duplicates:
        print("scuderia skill-check: FAIL — skill-name collisions across sources")
        for name, locs in sorted(duplicates.items()):
            print(f"  - {name}:")
            for loc in locs:
                print(f"      {loc}")
        return 1
    if warnings and args.strict:
        print("scuderia skill-check: FAIL (--strict: warnings treated as failures)")
        return 1
    print(f"scuderia skill-check: OK — {count} skills across {len(roots)} root(s), "
          f"no name collisions" + (f", {len(warnings)} warning(s)" if warnings else ""))
    return 0



def cmd_adopt(args: argparse.Namespace) -> int:
    path = args.path.expanduser().resolve()
    if not path.is_dir():
        sys.exit(f"scuderia adopt: {path} is not a directory")
    contract_file = path / "instance.yaml"
    legacy_file = path / "brain.yaml"
    if contract_file.exists() or legacy_file.exists():
        sys.exit(f"scuderia adopt: {contract_file if contract_file.exists() else legacy_file} "
                 f"already exists — refusing to "
                 f"overwrite; run `scuderia doctor --path {path}` instead")

    name = args.name or path.name
    doc = {
        "name": name,
        "profile": args.profile,
        "profile_version": 1,
        "schema_version": 1,
        "created": datetime.date.today().isoformat(),
    }
    contract_file.write_text(
        "# instance.yaml — the instance contract (generated by `scuderia adopt`)\n"
        + yaml.safe_dump(doc, sort_keys=False, default_flow_style=False),
        encoding="utf-8")
    print(f"scuderia adopt: wrote {contract_file} (name: {name}, profile: "
          f"{args.profile})")

    complaints = check_contract(path, args.profile)
    if complaints:
        print("scuderia adopt: instance.yaml written, but the contract is not met:")
        for c in complaints:
            print(f"  - {c}")
        return 1
    print("scuderia adopt: instance valid")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="scuderia", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="scaffold a new instance")
    p_init.add_argument("--profile", default="mnemo")
    p_init.add_argument("--name", required=True)
    p_init.add_argument("--path", type=Path, required=True)
    p_init.add_argument("--force", action="store_true")
    p_init.set_defaults(fn=cmd_init)

    p_doc = sub.add_parser("doctor", help="verify the instance contract")
    p_doc.add_argument("--path", type=Path, default=Path.cwd())
    p_doc.add_argument("--profile", default=None)
    p_doc.set_defaults(fn=cmd_doctor)

    p_check = sub.add_parser(
        "skill-check",
        help="fail on skill-name collisions across skills roots (shared + "
             "profile-scoped); warn on patch-marker skills")
    p_check.add_argument("--root", type=Path, default=None,
                         help="scuderia checkout to scan (default: this one)")
    p_check.add_argument("--strict", action="store_true",
                         help="treat patch-marker warnings as failures")
    p_check.set_defaults(fn=cmd_skill_check)

    p_adopt = sub.add_parser("adopt", help="generate brain.yaml for an existing brain")
    p_adopt.add_argument("--path", type=Path, required=True)
    p_adopt.add_argument("--name", default=None)
    p_adopt.add_argument("--profile", default="mnemo")
    p_adopt.set_defaults(fn=cmd_adopt)

    args = parser.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
